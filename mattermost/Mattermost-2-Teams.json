      "name": "Quick Response"
    },
    {
      "parameters": {
        "jsCode": "const message = $input.first().json.props.attachments[0].footer\n\nconst match = message.match(/Ref:(\\S+)/);\nconst msteamsrefid = match ? match[1] : null;\n\nconst msteamschatsid = (msteamsrefid != null && msteamsrefid.match(/chats\\('([^']+)'\\)/)) ? msteamsrefid.match(/chats\\('([^']+)'\\)/)[1] : null;\nconst msteamsteamid = (msteamsrefid != null && msteamsrefid.match(/teams\\('([^']+)'\\)/)) ? msteamsrefid.match(/teams\\('([^']+)'\\)/)[1] : null;\nconst msteamschannelid = (msteamsrefid != null && msteamsrefid.match(/channels\\('([^']+)'\\)/)) ? msteamsrefid.match(/channels\\('([^']+)'\\)/)[1] : null;\nconst msteamsmessageid = (msteamsrefid != null && msteamsrefid.match(/messages\\('([^']+)'\\)/)) ? msteamsrefid.match(/messages\\('([^']+)'\\)/)[1] : null;\n\nreturn [{ \n  json: { ...$input.first().json, msteamschannelid, msteamsmessageid, msteamschatsid, msteamsteamid } }];"
      },
      "type": "n8n-nodes-base.code",
