        "responseBody": "={\n\"attachments\": [\n    {\n      \"color\": \"#4052ab\",\n      \"title\": \"MS-Teams Responder\",\n      \"text\": \"Your message will be forwarded to: {{ $json.msteamsmessageid }}\"\n    }\n  ]\n}",
