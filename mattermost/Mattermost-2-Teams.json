      "parameters": {
        "jsCode": "const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nreturn [{ json: \n{ message: {\n  \"body\": {\n    \"contentType\": \"html\",\n    \"content\": \"<attachment id=\\\"\"+ $('Extract MS-Teams Ref ID').first().json.msteamsmessageid +\"\\\"></attachment><p><img src=\\\"../hostedContents/1/$value\\\" /></p>\"\n  },\n  \"attachments\": [\n    {\n      \"id\": $('Extract MS-Teams Ref ID').first().json.msteamsmessageid,\n      \"contentType\": \"messageReference\",\n      \"contentUrl\": null,\n      \"content\": \"{\\\"messageId\\\":\\\"\" + $('Extract MS-Teams Ref ID').first().json.msteamsmessageid + \"\\\"}\",\n      \"name\": null,\n      \"thumbnailUrl\": null\n    }\n  ],\n  \"hostedContents\": [\n    {\n      \"@microsoft.graph.temporaryId\": \"1\",\n      \"contentType\": \"image/png\",\n      \"contentBytes\": buf.toString('base64')\n    }\n  ]\n}\n}\n}];\n"
      },
