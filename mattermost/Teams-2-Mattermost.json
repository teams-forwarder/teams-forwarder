{
  "name": "Teams-2-Mattermost",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const messageBody = $json.body.content;\nconst imgRegex = /<img[^>]+src=\"(https:\\/\\/[^\"]*graph\\.microsoft\\.com[^\"]*)\"/gi;\n\nconst imageUrls = [];\nlet match;\n\nwhile ((match = imgRegex.exec(messageBody)) !== null) {\n  imageUrls.push(match[1]);\n}\n\nif (imageUrls.length === 0) {\n  return [{ json: { hasImage: false, imageUrl: null } }];\n}\n\n// Return one item per image — so the next nodes process each one individually\nreturn imageUrls.map(url => ({ json: { hasImage: true, imageUrl: url } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -96,
        -160
      ],
      "id": "35acfb9d-e978-4f91-95cf-c7564c95da04",
      "name": "Extract Image URLs",
      "notesInFlow": false
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = $json.body.content;\n\nconst plain_message = html\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<\\/p>/gi, '\\n')\n  .replace(/<p[^>]*>/gi, '')\n  .replace(/<strong[^>]*>(.*?)<\\/strong>/gi, '**$1**')\n  .replace(/<b[^>]*>(.*?)<\\/b>/gi, '**$1**')\n  .replace(/<em[^>]*>(.*?)<\\/em>/gi, '*$1*')\n  .replace(/<i[^>]*>(.*?)<\\/i>/gi, '*$1*')\n  .replace(/<a[^>]*href=\"([^\"]*)\"[^>]*>(.*?)<\\/a>/gi, '[$2]($1)')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&nbsp;/g, ' ')\n  .trim();\n\nreturn { json: { plain_message } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
        -336
      ],
      "id": "5f5831c9-b12e-4f87-bc34-2b43c3c6ce79",
