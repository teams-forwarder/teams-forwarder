    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet messageText = '';\nconst fileIds = [];\nconst imageUrls = [];\n\nfor (const item of items) {\n  // Pick up message text if present\n  if (item.json.plain_message) {\n    messageText = item.json.plain_message;\n  }\n\n  // Pick up file IDs from file_infos array if present\n  if (item.json.file_infos && Array.isArray(item.json.file_infos)) {\n    for (const fileInfo of item.json.file_infos) {\n      if (fileInfo.id) {\n        fileIds.push(fileInfo.id);\n        imageUrls.push(`${$('Set Workflow Constants').first().json.Mattermost_URL}/v4/files/${fileInfo.id}`);\n      }\n    }\n  }\n}\n\nconst chatTriggered  = $('Incoming Message (Chat)').isExecuted;\nconst channelTriggered = $('Incoming Message (Channel)').isExecuted;\nlet footerRef;\nif (chatTriggered) {\n  footerRef = \"Ref:\" + $('Incoming Message (Chat)').first().json['@odata.id'];\n} else if (channelTriggered) {\n  footerRef = \"Ref:\" + $('Incoming Message (Channel)').first().json['@odata.id'];\n}\n\nconst firstAttachment = {\n  color: \"#4542F8\",\n  author_name: \"MS-Teams Message\",\n  title: $('Set Workflow Constants').first().json.from.user.displayName,\n  text: messageText,\n  footer: footerRef,\n  ...(imageUrls && imageUrls.length > 0 ? { image_url: imageUrls[0] } : {})\n};\n\nconst additionalAttachments = (imageUrls && imageUrls.length > 1)\n  ? imageUrls.slice(1).map(url => ({ image_url: url })) : [];\n\nconst body = {\n  channel_id: $('Set Workflow Constants').first().json.Mattermost_ChannelID,\n  message: \"\",\n  props: {\n    attachments: [firstAttachment, ...additionalAttachments]\n  }\n};\n\nreturn [{\n  json: {\n    messageText: messageText,\n    fileIds: fileIds.length > 0 ? fileIds : [],\n    imageUrls: imageUrls.length > 0 ? imageUrls : [],\n    hasMessage: messageText.length > 0,\n    hasFiles: fileIds.length > 0,\n    postbody: body\n  }\n}];"
      },
