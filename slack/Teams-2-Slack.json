    {
      "parameters": {
        "jsCode": "const results = [];\nconst items = $input.all();\n\nfor (let index = 0; index < items.length; index++) {\n  const item = items[index];\n  \n  results.push({\n    json: {},\n    binary: {\n      data: {\n        ...item.binary.data,\n        fileName: `img${index}.png`,\n        mimeType: item.binary.data.mimeType,\n      }\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
