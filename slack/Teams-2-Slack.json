        -240
      ],
      "id": "dbeede02-9fd1-4e06-8310-ed45962fc74b",
      "name": "Strip Binary Files"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst chatTriggered  = $('Incoming Message (Chat)').isExecuted;\nconst channelTriggered = $('Incoming Message (Channel)').isExecuted;\nlet footerRef;\nif (chatTriggered) {\n  footerRef = \"Ref:\" + $('Incoming Message (Chat)').first().json['@odata.id'];\n} else if (channelTriggered) {\n  footerRef = \"Ref:\" + $('Incoming Message (Channel)').first().json['@odata.id'];\n}\n\n\nlet messageText = ' ';\n\nfor (const item of items) {\n  // Pick up message text if present\n  if (item.json.plain_message) {\n    messageText = item.json.plain_message;\n    if (messageText == \"\") {\n      messageText=' ';\n    }\n  }\n}\n\nconst body = {\n  channel: $('Set Workflow Constants').first().json.Slack_MemberID,\n  text: \"\",\n  attachments: [{\n    color: \"#4542F8\",\n    blocks: [\n      {\n        \"type\": \"context\",\n        \"elements\": [{ \"type\": \"mrkdwn\", \"text\": \"*MS-Teams Message*\" }]\n      },\n      {\n        \"type\": \"header\",\n        \"text\": { \"type\": \"plain_text\", \"text\": $('Set Workflow Constants').first().json.from.user.displayName }\n      },\n      {\n        \"type\": \"section\",\n        \"text\": { \"type\": \"mrkdwn\", \"text\": messageText }\n      },\n      {\n        \"type\": \"context\",\n        \"elements\": [{ \"type\": \"mrkdwn\", \"text\": footerRef }]\n      }\n    ]\n  }]\n};\n\nreturn [{\n  json: {\n    messageText: messageText,\n    hasMessage: messageText.length > 0,\n    postbody: body\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
