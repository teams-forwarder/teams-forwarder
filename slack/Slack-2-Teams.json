      "parameters": {
        "jsCode": "function findRef(node) {\n  if (node === null || typeof node !== 'object') return null;\n\n  if (Array.isArray(node)) {\n    for (const child of node) {\n      const hit = findRef(child);\n      if (hit) return hit;\n    }\n    return null;\n  }\n\n  if (typeof node.text === 'string' && node.text.startsWith('Ref:')) {\n    return node.text;\n  }\n\n  for (const value of Object.values(node)) {\n    const hit = findRef(value);\n    if (hit) return hit;\n  }\n  return null;\n}\n\nconst msteamsrefid = findRef($input.first().json.messages);\n\nif (!msteamsrefid) {\n  return [];   // nothing found — downstream branch sees no items\n}\n\nconst msteamschatsid = (msteamsrefid.match(/chats\\('([^']+)'\\)/)) ? msteamsrefid.match(/chats\\('([^']+)'\\)/)[1] : null;\nconst msteamsteamid = (msteamsrefid.match(/teams\\('([^']+)'\\)/)) ? msteamsrefid.match(/teams\\('([^']+)'\\)/)[1] : null;\nconst msteamschannelid = (msteamsrefid.match(/channels\\('([^']+)'\\)/)) ? msteamsrefid.match(/channels\\('([^']+)'\\)/)[1] : null;\nconst msteamsmessageid = (msteamsrefid.match(/messages\\('([^']+)'\\)/)) ? msteamsrefid.match(/messages\\('([^']+)'\\)/)[1] : null;\n\nreturn [{ \n  json: { ...$input.first().json, msteamschannelid, msteamsmessageid, msteamschatsid, msteamsteamid } }];"
      },
